# 0. Deps (cached independently of application source)
FROM node:24.12.0-alpine AS deps
WORKDIR /app
COPY upstream-ui/package.json upstream-ui/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund

# 1. Builder
FROM node:24.12.0-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules

# Use upstream UI source (checked out at upstream-ui/ in CI)
COPY upstream-ui/ .

# Remove upstream's config + standaloneSignIn so we don't have two
# (upstream ships this as .ts, not .tsx - match the real filename or the
# rm is a no-op and both files end up coexisting in the build)
RUN rm -f next.config.ts
RUN rm -f src/actions/standalone/standaloneSignIn.ts

# Override with our Next.js config (replaces upstream's) + standaloneSignIn
COPY next.config.ts ./next.config.ts
COPY standaloneSignIn.ts ./src/actions/standalone/standaloneSignIn.ts

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# 2. Runner (multi-arch)
FROM node:24.12.0-alpine AS runner
WORKDIR /app

# Create non-root user
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs

# Copy standalone output and required static assets
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

USER nextjs

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "server.js"]
